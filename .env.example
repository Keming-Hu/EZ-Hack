EZ_HACK_HOME=/absolute/path/to/EZ Hack
EZ_HACK_HOST=127.0.0.1
EZ_HACK_PORT=8000
EZ_HACK_PUBLIC_URL=http://127.0.0.1:8000/mcp
EZ_HACK_ISSUER_URL=https://ez-hack.local
# Required for non-local deployment. Comma-separated exact Host values.
# EZ_HACK_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:*
# EZ_HACK_ALLOWED_ORIGINS=https://app.example.com
